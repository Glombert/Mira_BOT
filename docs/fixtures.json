  "scenarios": {
    "$comment": "Полные сценарии — последовательности сообщений для тестирования UX",

    "first_login": [
      { "from": "client", "data": { "type": "ping" } },
      { "from": "server", "data": { "type": "pong" } },
      { "from": "server", "data": { "type": "ready", "name": "Andrey" } },
      { "from": "client", "data": { "content": "Привет, я первый раз тут" } },
      { "from": "server", "data": { "type": "thinking" } },
      { "from": "server", "data": { "type": "message", "content": "Привет, Андрей. Рада познакомиться. Расскажи немного о себе — чем занимаешься?" } }
    ],

    "file_upload_and_chat": [
      { "from": "client", "data": { "type": "command", "cmd": "files" } },
      { "from": "server", "data": { "type": "files", "files": [] } },
      { "from": "client", "data": { "$action": "POST /upload data.csv (1.2 KB)" } },
      { "from": "server_http", "data": { "ok": true, "filename": "data.csv", "size": 1234 } },
      { "from": "client", "data": { "content": "Посмотри в файл data.csv и скажи сколько там строк" } },
      { "from": "server", "data": { "type": "thinking" } },
      { "from": "server", "data": { "type": "message", "content": "В data.csv 47 строк. Колонки: дата, продукт, сумма. Если нужно — могу посчитать общую выручку." } }
    ],

