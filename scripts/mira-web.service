[Unit]
Description=Mira Web Interface
After=network.target mira-bot.service

[Service]
Type=simple
# SECURITY TODO: создать пользователя mira:mira и сменить WorkingDirectory/ExecStart
# на /opt/mira_agent вместо /root/mira_agent. Пока оставлено как есть чтобы не сломать прод.
# User=mira
# Group=mira
WorkingDirectory=/root/mira_agent
ExecStart=/root/mira_agent/venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s

# --- Resource limits ---
# VPS 961MB RAM, на той же машине WireGuard+sing-box. Лимиты на сервис, чтобы
# рантайм-утечка убивала СВОЙ сервис (с авто-рестартом), а не уходила в kernel
# OOM-killer, который может прибить VPN/sshd. ~2x от наблюдаемого пика (174MB).
MemoryHigh=350M
MemoryMax=450M
TasksMax=256

# SECURITY TODO: включить sandboxing после смены пользователя
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
# RestrictRealtime=true
# RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
