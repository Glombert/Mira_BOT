# Nginx конфиг для Миры — шаблон.
# Скопируй в /etc/nginx/sites-available/mira и замени YOUR_DOMAIN.
# Сертификат получи через acme.sh (см. README раздел "Развёртывание на VPS").

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Rate limiting zone for auth endpoints
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

# HTTPS — основной
server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/ssl/mira/fullchain.cer;
    ssl_certificate_key /etc/ssl/mira/key.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # Mozilla Intermediate configuration (2024)
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MiraSSL:10m;
    ssl_session_tickets off;

    # Hide nginx version from error pages
    server_tokens off;

    # HSTS — force HTTPS for 1 year, include subdomains
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Security headers (ASVS V13)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/ssl/mira/fullchain.cer;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # Лимит размера загружаемых файлов. По умолчанию nginx режет до 1MB,
    # из-за чего телефонные фотки (3-5 MB) не проходят. Сервер сам разрешает
    # до 20 MB (см. UPLOAD_MAX_BYTES в web/app.py), nginx нужно поднимать тоже.
    client_max_body_size 25m;

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        # 1 час: WebSocket-чат не должен рваться при коротких отлучках (фон/сон
        # вкладки замораживает пинги). Клиент сам реконнектится при возврате.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Stricter rate limit on auth endpoints
    location /auth/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# HTTP → HTTPS редирект
server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://YOUR_DOMAIN$request_uri;
}
