[Unit]
Description=Mira AI Bot
After=network.target

[Service]
Type=simple
# --- SECURITY: hardened non-root service ---
# После создания пользователя mira:mira и переноса репо в /opt/mira_agent,
# раскомментируй строки ниже и удали root-версии.
# Сейчас оставлено как есть чтобы не сломать прод автозаменой.
# User=mira
# Group=mira
WorkingDirectory=/root/mira_agent
ExecStart=/root/mira_agent/venv/bin/python telegram_bot.py
Restart=on-failure
RestartSec=5s

# Sandboxing (enable after switching to non-root user):
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/root/mira_agent/memory /root/mira_agent/workspace /root/mira_agent/logs /root/mira_agent/versions
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
# RestrictRealtime=true
# RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
