# Секреты — никогда в git
.env
credentials.json
token.json
client_secret*.json
# Firebase Admin SDK service account JSON — закрытый ключ для отправки FCM
.firebase-service-account.json
firebase-service-account*.json

# История диалога (личные данные)
chat_history.json

# Рабочие файлы пользователей
workspace/

# Память агента (личные данные)
memory/

# Резервные копии кода
versions/

# Python мусор
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Виртуальное окружение
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Логи — ежедневная ротация, 3 дня хранения, в git не нужны
logs/
*.log
.aider*

# Клиенты (web/desktop) — артефакты сборки.
# dist/ уже покрыт строкой выше — туда падает Next.js export.
clients/node_modules/
clients/**/.next/
clients/**/target/
clients/**/.env
clients/**/.env.*
